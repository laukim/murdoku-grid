{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murdoku-grid",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // SESSION_SECRET signs the 30-day session cookie. It is a Worker secret,
  // not a var: npx wrangler secret put SESSION_SECRET
  // Do not put the secret in this file.
  // Branches other than main run `npx wrangler preview`. That command
  // requires this block. It stays empty, so the preview does not receive
  // the production D1 binding.
  "previews": {},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "murdoku-layouts",
      "database_id": "99a3ebdf-139e-4421-8736-fa32f9d261d8",
      "migrations_dir": "migrations"
    }
  ]
}
